rules_version = '2';

// Managers upload/replace files; the restricted owner (Adam) can only read.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.email in ['mdulin@gmail.com', 'adamjosephbritten@gmail.com', 'dulinliam@gmail.com'];
      allow write: if request.auth != null
        && request.auth.token.email in ['mdulin@gmail.com', 'dulinliam@gmail.com'];
    }
  }
}
