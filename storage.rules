rules_version = '2';

// Mirror of the PUBLISHED Storage rules (published in-console 2026-07-02).
// Replaced the default test-mode rules (public read/write, expiring 2026-08-25)
// which left every document/photo world-readable AND would have broken uploads in August.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['mdulin@gmail.com', 'adamjosephbritten@gmail.com', 'dulinliam@gmail.com'];
    }
  }
}
